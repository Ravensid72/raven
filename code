#include <iostream>
#include <string>

#ifdef _WIN32
    #include <conio.h>
#else
    #include <termios.h>
    #include <unistd.h>

    char _getch() {
        char buf = 0;
        struct termios old = {0};
        tcgetattr(0, &old);
        struct termios newt = old;
        newt.c_lflag &= ~ICANON;
        newt.c_lflag &= ~ECHO;
        tcsetattr(0, TCSANOW, &newt);
        buf = getchar();
        tcsetattr(0, TCSANOW, &old);
        return buf;
    }
#endif

using namespace std;

string readMaskedPassword() {
    string password = "";
    char ch;

    while ((ch = _getch()) != '\r' && ch != '\n') { 
        if (ch == '\b' || ch == 127) { 
            if (!password.empty()) {
                password.pop_back();
                cout << "\b \b";
            }
        } else {
            password += ch;
            cout << '*';
        }
    }
    cout << endl;
    return password;
}

int main() {
    string setUsername, setPassword;
    string username, password;

    cout << "REGISTER ACCOUNT" << endl;

    cout << "\nCreate Username: ";
    cin >> setUsername;
    cin.ignore();

    cout << "Create Password: ";
    setPassword = readMaskedPassword();

    cout << "\nAccount created successfully!\n" << endl;

    cout << "USER LOGIN" << endl;

    cout << "\nUsername: ";
    cin >> username;
    cin.ignore();

    cout << "Password: ";
    password = readMaskedPassword();

    cout << "\nUsername: " << username << endl;
    cout << "Password: ";
    for (int i = 0; i < password.length(); i++) {
        cout << "*";
    }
    cout << endl;

    if (username == setUsername && password == setPassword) {
        cout << "\nLogin successful!" << endl;
    } else {
        cout << "\nInvalid username or password." << endl;
    }

    return 0;
}
